#| msgid "Couldn't load bitmap"
msgid "Couldn’t load bitmap"
msgstr "Klarte ikkje laste punktbiletet"

#: gdk-pixbuf/io-gdip-utils.c:776
#| msgid "Couldn't load metafile"
msgid "Couldn’t load metafile"
msgstr "Klarte ikkje laste metafil"

#: gdk-pixbuf/io-gdip-utils.c:881
msgid "Unsupported image format for GDI+"
msgstr "Ikkje støtta bileteformat for GDI+"

#: gdk-pixbuf/io-gdip-utils.c:888
#| msgid "Couldn't save"
msgid "Couldn’t save"
msgstr "Klarte ikkje lagre"

#: gdk-pixbuf/io-gdip-wmf.c:60
msgctxt "image format"
msgid "WMF"
msgstr "WMF"

#: gdk-pixbuf/io-gif.c:160
#, c-format
msgid "Failure reading GIF: %s"
msgstr "Klarte ikkje lese GIF: %s"

#: gdk-pixbuf/io-gif.c:383 gdk-pixbuf/io-gif.c:850 gdk-pixbuf/io-gif.c:903
#: gdk-pixbuf/io-gif.c:976
msgid "Not enough memory to load GIF file"
msgstr "Ikkje nok minne til å laste GIF-fila"

#: gdk-pixbuf/io-gif.c:509
msgid "GIF image is corrupt (incorrect LZW compression)"
msgstr "GIF-biletet er øydelagt (ikkje rett LZW-kompresjon)"

#: gdk-pixbuf/io-gif.c:545
msgid "File does not appear to be a GIF file"
msgstr "Fila ser ikkje ut til å vere ei GIF-fil"

#: gdk-pixbuf/io-gif.c:560
#, c-format
msgid "Version %s of the GIF file format is not supported"
msgstr "Versjon %s av GIF-filformatet er ikkje støtta"

#: gdk-pixbuf/io-gif.c:589
#| msgid "Image has zero width"
msgid "Resulting GIF image has zero size"
msgstr "Resultat-GIF-biletet har null storleik"

#: gdk-pixbuf/io-gif.c:659
msgid ""
"GIF image has no global colormap, and a frame inside it has no local "
"colormap."
msgstr ""
"GIF-biletet har ikkje noko globalt fargekart, og ei ramme inni det har ikkje "
"noko lokalt fargekart."

#: gdk-pixbuf/io-gif.c:863 gdk-pixbuf/io-gif.c:988
msgid "GIF file was missing some data (perhaps it was truncated somehow?)"
msgstr "GIF-fil manglar data (Har fila vorte kutta?)"

#: gdk-pixbuf/io-gif.c:922
msgid "GIF image was truncated or incomplete."
msgstr "GIF-biletet vart avkorta eller er ufullstendig."

#: gdk-pixbuf/io-gif.c:929
msgid "Not all frames of the GIF image were loaded."
msgstr "Ikkje alle rammer av GIF-biletet vart lada."

#: gdk-pixbuf/io-icns.c:363
#, c-format
msgid "Error reading ICNS image: %s"
msgstr "Fatal feil under lesing av ICNS-biletefil: %s"

#: gdk-pixbuf/io-icns.c:380 gdk-pixbuf/io-icns.c:461
msgid "Could not decode ICNS file"
msgstr "Klarte ikkje dekode ICNS-fil"

#: gdk-pixbuf/io-icns.c:517
msgctxt "image format"
msgid "MacOS X icon"
msgstr "MacOS X-ikon"

#: gdk-pixbuf/io-ico.c:238 gdk-pixbuf/io-ico.c:252 gdk-pixbuf/io-ico.c:342
#: gdk-pixbuf/io-ico.c:426 gdk-pixbuf/io-ico.c:451
#, c-format
#| msgid "Invalid header in icon"
msgid "Invalid header in icon (%s)"
msgstr "Ugyldig hovud i ikonet (%s)"

#: gdk-pixbuf/io-ico.c:268 gdk-pixbuf/io-ico.c:355 gdk-pixbuf/io-ico.c:461
#: gdk-pixbuf/io-ico.c:504 gdk-pixbuf/io-ico.c:532
msgid "Not enough memory to load icon"
msgstr "Ikkje nok minne til å laste ikonet"

#: gdk-pixbuf/io-ico.c:386
msgid "Invalid header in icon"
msgstr "Ugyldig hovud i ikon"

#: gdk-pixbuf/io-ico.c:387
msgid "Compressed icons are not supported"
msgstr "Komprimerte ikon er ikkje støtta"

#: gdk-pixbuf/io-ico.c:489
msgid "Unsupported icon type"
msgstr "Ikontypen er ikkje støtta"

#: gdk-pixbuf/io-ico.c:583
msgid "Not enough memory to load ICO file"
msgstr "Ikkje nok minne til å laste ICO-fila"

#: gdk-pixbuf/io-ico.c:629
#| msgid "GIF image was truncated or incomplete."
msgid "ICO image was truncated or incomplete."
msgstr "ICO-biletet vart avkorta eller er ufullstendig."

#: gdk-pixbuf/io-ico.c:1070
msgid "Image too large to be saved as ICO"
msgstr "Biletet er for stort til å lagrast som ICO"

#: gdk-pixbuf/io-ico.c:1081
msgid "Cursor hotspot outside image"
msgstr "Peikarpunktet utanfor biletet"

#: gdk-pixbuf/io-ico.c:1104
#, c-format
msgid "Unsupported depth for ICO file: %d"
msgstr "Djupna til biletet er for djup for ei ICO-fil: %d"

#: gdk-pixbuf/io-jpeg.c:131
#, c-format
msgid "Error interpreting JPEG image file (%s)"
msgstr "Feil under tolking av JPEG-biletefil (%s)"

#: gdk-pixbuf/io-jpeg.c:642 gdk-pixbuf/io-jpeg.c:1167
#, c-format
#| msgid "Unsupported JPEG color space (%s)"
msgid "Unsupported number of color components (%d)"
msgstr "Ikkje støtta tal på fargekomponentar (%d)"

#: gdk-pixbuf/io-jpeg.c:661
msgid ""
"Insufficient memory to load image, try exiting some applications to free "
"memory"
msgstr ""
"Ikkje nok minne til å laste biletet. Prøv å avslutte nokre program for å "
"frigjere minne"

#: gdk-pixbuf/io-jpeg.c:734 gdk-pixbuf/io-jpeg.c:984
#, c-format
msgid "Unsupported JPEG color space (%s)"
msgstr "Ustøtta JPEG-fargerom (%s)"

#: gdk-pixbuf/io-jpeg.c:859 gdk-pixbuf/io-jpeg.c:1183 gdk-pixbuf/io-jpeg.c:1530
#: gdk-pixbuf/io-jpeg.c:1540
#| msgid "Couldn't allocate memory for loading JPEG file"
msgid "Couldn’t allocate memory for loading JPEG file"
msgstr "Klarte ikkje tildele minne for innlasting av JPEG-fil"

#: gdk-pixbuf/io-jpeg.c:1141
msgid "Transformed JPEG has zero width or height."
msgstr "Transformert JPEG har breidd eller storleik lik null."

#: gdk-pixbuf/io-jpeg.c:1460
#, c-format
#| msgid ""
#| "JPEG quality must be a value between 0 and 100; value '%d' is not allowed."
msgid ""
"JPEG x-dpi must be a value between 1 and 65535; value “%s” is not allowed."
msgstr ""
"JPEG x-dpi må vere ein verdi mellom 1 og 65535; verdien «%s» er ikkje "
"tillaten."

#: gdk-pixbuf/io-jpeg.c:1481
#, c-format
#| msgid ""
#| "JPEG quality must be a value between 0 and 100; value '%d' is not allowed."
msgid ""
"JPEG y-dpi must be a value between 1 and 65535; value “%s” is not allowed."
msgstr ""
"JPEG y-dpi må vere ein verdi mellom 1 og 65535; verdien «%s» er ikkje "
"tillaten."

#: gdk-pixbuf/io-jpeg.c:1495
#, c-format
msgid "Color profile has invalid length “%u”."
msgstr "Fargeprofilen har ugyldig lengd «%u»."

#: gdk-pixbuf/io-png.c:64
